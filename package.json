{
  "name": "prisma-extension-casl",
  "version": "2.0.0",
  "description": "Enforce casl abilities on prisma client ",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "repository": {
    "type": "git",
    "url": "https://github.com/dennemark/prisma-extension-casl.git"
  },
  "scripts": {
    "build": "prisma generate && tsup src/index.ts --format=esm --dts",
    "watch": "prisma generate && tsup src/index.ts --format=esm --dts --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "release": "release-it"
  },
  "files": [
    "dist",
    "prisma/generators/metadata.js"
  ],
  "keywords": [
    "prisma",
    "@prisma/client",
    "extension"
  ],
  "author": "dennemark",
  "license": "MIT",
  "peerDependencies": {
    "@casl/ability": "^7.0.0",
    "@casl/prisma": "^2.0.0",
    "@prisma/client": "^7.0.0",
    "@prisma/generator-helper": "^7.0.0"
  },
  "devDependencies": {
    "@casl/ability": "^7.0.0",
    "@casl/prisma": "^2.0.1",
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@prisma/generator-helper": "^7.0.0",
    "@release-it/conventional-changelog": "^10.0.0",
    "@types/node": "^22.14.0",
    "better-sqlite3": "^11.0.0",
    "esbuild": "^0.25.2",
    "prisma": "^7.0.0",
    "release-it": "^18.1.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.8"
  }
}