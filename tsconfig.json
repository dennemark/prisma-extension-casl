{
    "compilerOptions": {
      "rootDir": ".",
      "outDir": "./dist",
      "target": "ESNext",
      "lib": ["ESNext"],
      "module": "NodeNext",
      "moduleResolution": "nodenext",
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "strict": true,
      "skipLibCheck": true,
      "declaration": true,
      "types": ["node", "vitest/globals"]
    },
    "include": ["src/**/*.ts", "test/**/*.ts"],

  }